{
  "name": "code-reviewer",
  "version": "0.1.0",
  "author": "Code_Reviewer",
  "description": "Code Reviewer Application",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build:native": ".\\build_native.bat",
    "build": "npm run build:native && electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext js,jsx,ts,tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,json,md}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sentry/electron": "^4.16.0",
    "@tanstack/react-query": "^5.0.0",
    "clsx": "^2.1.0",
    "dotenv": "^18.0.6",
    "framer-motion": "^14.5.0",
    "lucide-react": "^0.300.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.50.0",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.2.0",
    "yauzl": "^3.4.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.1",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.7.0",
    "adm-zip": "^0.6.1",
    "autoprefixer": "^10.4.17",
    "axe-core": "^4.8.3",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "eslint": "^8.56.0",
    "husky": "^9.0.5",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.2.0"
  }
